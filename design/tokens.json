{
  "name": "OpenHalo Design System Tokens",
  "version": "1.0.0",
  "platform": "macOS",
  "dimensions": {
    "notch": {
      "width": 204,
      "height": 34,
      "cornerRadius": 10
    },
    "compactPill": {
      "width": 190,
      "height": 36,
      "cornerRadius": 18
    },
    "expandedMedium": {
      "width": 380,
      "height": 84,
      "cornerRadius": 24
    },
    "expandedLarge": {
      "width": 440,
      "height": 180,
      "cornerRadius": 32
    },
    "fileShelf": {
      "width": 460,
      "height": 120,
      "cornerRadius": 26
    }
  },
  "colors": {
    "islandBackground": "#000000F2",
    "islandBorder": "#FFFFFF18",
    "surfaceSecondary": "#1C1C1EE6",
    "textPrimary": "#FFFFFF",
    "textSecondary": "#8E8E93",
    "accentGreen": "#30D158",
    "accentOrange": "#FF9F0A",
    "accentRed": "#FF453A",
    "accentBlue": "#0A84FF",
    "accentPurple": "#BF5AF2"
  },
  "typography": {
    "fontFamily": "SF Pro, -apple-system, BlinkMacSystemFont, sans-serif",
    "title": { "size": 14, "weight": 600 },
    "body": { "size": 12, "weight": 400 },
    "caption": { "size": 10, "weight": 500 },
    "metric": { "size": 18, "weight": 700 }
  },
  "animation": {
    "spring": {
      "response": 0.35,
      "dampingRatio": 0.72,
      "blendDuration": 0.15
    },
    "autoCollapseSeconds": 3.0
  }
}

